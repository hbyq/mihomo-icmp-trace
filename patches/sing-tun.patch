+func TestTraceRestore(t *testing.T) {
+	for _, v6 := range []bool{false, true} {
+		source, visible, real, router, egress := "198.18.0.1", "198.18.0.50", "203.0.113.20", "192.0.2.1", "192.0.2.10"
+		off := 20
+		if v6 {
+			source, visible, real, router, egress = "fd00::1", "fd00::50", "2001:db8:1::20", "2001:db8::1", "2001:db8::10"
+			off = 40
+		}
+		original := testTracePacket(source, visible, 2, testTraceEcho(v6, 123, 456, false))
+		probe := traceProbe{header: original[:off+8], source: netip.MustParseAddr(source), target: netip.MustParseAddr(visible), sequence: 456}
+		for _, kind := range []string{"echo", "time-exceeded", "unreachable", "packet-too-big", "parameter-problem"} {
+			t.Run(real+"/"+kind, func(t *testing.T) {
+				var packet []byte
+				if kind == "echo" {
+					packet = testTracePacket(real, egress, 51, testTraceEcho(v6, 789, 456, true))
+				} else {
+					quoted := testTracePacket(egress, real, 1, testTraceEcho(v6, 789, 456, false))
+					// Real ICMP errors commonly contain only the header + 8 bytes.
+					body := make([]byte, 8+off+8)
+					copy(body[8:], quoted[:off+8])
+					if v6 {
+						switch kind {
+						case "time-exceeded":
+							body[0] = 3
+						case "unreachable":
+							body[0] = 1
+						case "packet-too-big":
+							body[0] = 2
+							binary.BigEndian.PutUint32(body[4:8], 1280)
+						case "parameter-problem":
+							body[0] = 4
+							body[7] = 6
+						}
+					} else {
+						switch kind {
+						case "time-exceeded":
+							body[0] = 11
+						case "unreachable":
+							body[0], body[1] = 3, 1
+						case "packet-too-big":
+							body[0], body[1] = 3, 4
+							binary.BigEndian.PutUint16(body[6:8], 1400)
+						case "parameter-problem":
+							body[0] = 12
+							body[4] = 9
+						}
+					}
+					packet = testTracePacket(router, egress, 51, body)
+				}
+				before := append([]byte(nil), packet...)
+				result, ok := restoreTraceReply(packet, netip.MustParseAddr(real), func(id, seq uint16) (traceProbe, bool) { return probe, id == 789 && seq == 456 })
+				if !ok {
+					t.Fatal("valid response rejected")
+				}
+				_, gotSource, gotTarget, err := traceIP(result, false)
+				if err != nil || gotTarget.String() != source {
+					t.Fatalf("destination not restored: %v %v", gotTarget, err)
+				}
+				if kind == "echo" {
+					if gotSource.String() != visible || binary.BigEndian.Uint16(result[off+4:off+6]) != 123 {
+						t.Fatal("echo source/identifier not restored")
+					}
+				} else {
+					if gotSource.String() != router {
+						t.Fatal("intermediate router was replaced by final target")
+					}
+					for _, i := range []int{0, 1, 4, 5, 6, 7} {
+						if result[off+i] != before[off+i] {
+							t.Fatal("error type/code/MTU changed")
+						}
+					}
+					q := result[off+8:]
+					_, qs, qd, err := traceIP(q, true)
+					if err != nil || qs.String() != source || qd.String() != visible {
+						t.Fatal("quoted addresses not restored")
+					}
+					for i := 2; i < 8; i++ {
+						if q[off+i] != original[off+i] {
+							t.Fatal("quoted identifier/checksum corrupted")
+						}
+					}
+					if !v6 && traceChecksum(q[:off]) != 0 {
+						t.Fatal("invalid quoted IP checksum")
+					}
+				}
+				expected := append([]byte(nil), result...)
+				traceChecksums(expected, off)
+				if string(expected) != string(result) {
+					t.Fatal("invalid outer checksum")
+				}
+			})
+		}
+	}
+}

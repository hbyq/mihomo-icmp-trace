+type traceTestContext chan []byte
+
+func (c traceTestContext) WritePacket(p []byte) error { c <- append([]byte(nil), p...); return nil }
+
+func TestTraceLoopback(t *testing.T) {
+	for _, target := range []string{"127.0.0.1", "::1"} {
+		t.Run(target, func(t *testing.T) {
+			addr := netip.MustParseAddr(target)
+			c := make(traceTestContext, 16)
+			d, err := ConnectTraceDestination(context.Background(), logger.NOP(), nil, addr, addr, c, 2*time.Second)
+			if err != nil {
+				t.Skipf("raw ICMP socket unavailable: %v", err)
+			}
+			defer d.Close()
+			var wg sync.WaitGroup
+			for i := 1; i <= 8; i++ {
+				wg.Add(1)
+				go func(i int) {
+					defer wg.Done()
+					if err := d.WritePacket(buf.As(testTracePacket(target, target, byte(i), testTraceEcho(addr.Is6(), 123, uint16(i), false))).ToOwned()); err != nil {
+						t.Errorf("write: %v", err)
+					}
+				}(i)
+			}
+			wg.Wait()
+			seen := make(map[uint16]bool)
+			for i := 0; i < 8; i++ {
+				select {
+				case p := <-c:
+					off, _, _, err := traceIP(p, false)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if binary.BigEndian.Uint16(p[off+4:off+6]) != 123 {
+						t.Fatal("wrong reply ID")
+					}
+					seq := binary.BigEndian.Uint16(p[off+6 : off+8])
+					if seen[seq] {
+						t.Fatal("duplicate reply")
+					}
+					seen[seq] = true
+				case <-time.After(3 * time.Second):
+					t.Fatal("no real loopback reply")
+				}
+			}
+		})
+	}
+}

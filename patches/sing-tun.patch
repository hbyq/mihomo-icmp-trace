+func TestTraceRejectUnrelatedAndMalformed(t *testing.T) {
+	packet := testTracePacket("203.0.113.20", "192.0.2.10", 51, testTraceEcho(false, 789, 456, true))
+	for n := 0; n < len(packet); n++ {
+		if _, ok := restoreTraceReply(append([]byte(nil), packet[:n]...), netip.MustParseAddr("203.0.113.20"), func(uint16, uint16) (traceProbe, bool) {
+			t.Fatal("lookup on truncated input")
+			return traceProbe{}, false
+		}); ok {
+			t.Fatal("accepted truncation")
+		}
+	}
+	if _, ok := restoreTraceReply(packet, netip.MustParseAddr("203.0.113.21"), func(uint16, uint16) (traceProbe, bool) {
+		t.Fatal("lookup for wrong target")
+		return traceProbe{}, false
+	}); ok {
+		t.Fatal("accepted unrelated source")
+	}
+	if _, ok := restoreTraceReply(packet, netip.MustParseAddr("203.0.113.20"), func(uint16, uint16) (traceProbe, bool) { return traceProbe{}, false }); ok {
+		t.Fatal("accepted unknown probe")
+	}
+}

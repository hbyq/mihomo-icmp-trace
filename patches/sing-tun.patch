+func testTraceRecordRoute(packet []byte) []byte {
+	p := make([]byte, len(packet)+40)
+	copy(p, packet[:20])
+	p[0] = 0x4f
+	p[20], p[21], p[22] = 7, 39, 4
+	copy(p[60:], packet[20:])
+	binary.BigEndian.PutUint16(p[2:4], uint16(len(p)))
+	traceChecksums(p, 60)
+	return p
+}
+
+func TestTraceRecordRouteValidation(t *testing.T) {
+	options := make([]byte, 40)
+	options[0], options[1] = 7, 39
+	for pointer := byte(4); pointer <= 40; pointer += 4 {
+		options[2] = pointer
+		if err := traceIPv4Options(options); err != nil {
+			t.Fatalf("valid pointer %d: %v", pointer, err)
+		}
+	}
+	for _, invalid := range [][]byte{
+		{7, 2, 4, 0}, {7, 7, 4, 0}, {7, 3, 5, 0}, {7, 3, 0, 0},
+		{7, 3, 8, 0}, {131, 3, 4, 0}, {137, 3, 4, 0}, {68, 3, 4, 0},
+		{0, 1, 0, 0}, {7, 3, 4, 7, 3, 4, 0, 0}, {7, 3, 4},
+	} {
+		if err := traceIPv4Options(invalid); err == nil {
+			t.Fatalf("invalid/unsupported options accepted: %v", invalid)
+		}
+	}
+	if err := traceIPv4Options([]byte{1, 1, 0, 0}); err != nil {
+		t.Fatal("valid NOP/EOL padding rejected")
+	}
+}
+
+func TestTraceRecordRouteRestore(t *testing.T) {
+	original := testTraceRecordRoute(testTracePacket("198.18.0.1", "198.18.0.50", 2, testTraceEcho(false, 123, 456, false)))
+	probe := traceProbe{header: original[:68], source: netip.MustParseAddr("198.18.0.1"),
+		target: netip.MustParseAddr("198.18.0.50"), sequence: 456}
+	for _, echo := range []bool{false, true} {
+		var packet []byte
+		if echo {
+			// A valid responder may omit RR options in the outer Echo reply.
+			packet = testTracePacket("203.0.113.20", "192.0.2.10", 51, testTraceEcho(false, 789, 456, true))
+		} else {
+			quote := testTraceRecordRoute(testTracePacket("192.0.2.10", "203.0.113.20", 1, testTraceEcho(false, 789, 456, false)))
+			body := make([]byte, 8+68)
+			body[0] = 11
+			copy(body[8:], quote[:68])
+			packet = testTracePacket("192.0.2.1", "192.0.2.10", 51, body)
+		}
+		restored, ok := restoreTraceReply(packet, netip.MustParseAddr("203.0.113.20"),
+			func(id, seq uint16) (traceProbe, bool) { return probe, id == 789 && seq == 456 })
+		if !ok {
+			t.Fatal("valid RR response rejected")
+		}
+		icmp := restored[20:]
+		if !echo {
+			icmp = icmp[8+60:]
+		}
+		if binary.BigEndian.Uint16(icmp[4:6]) != 123 || binary.BigEndian.Uint16(icmp[6:8]) != 456 {
+			t.Fatal("RR response original identifier/sequence not restored")
+		}
+		if !echo && string(icmp[2:8]) != string(original[62:68]) {
+			t.Fatal("RR error quote original ICMP checksum/header not restored")
+		}
+		if traceChecksum(restored[:20]) != 0 || traceChecksum(restored[20:]) != 0 {
+			t.Fatal("invalid RR response checksum")
+		}
+	}
+}

+func TestTraceHopBudgetOnWire(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		// Winsock raw sockets receive inbound datagrams; they do not promise
+		// to mirror locally generated loopback Echo requests. Verify the
+		// actual socket options and round trips here. Windows integration
+		// tests independently capture physical-egress TTL with WinDivert.
+		testTraceHopBudgetSocket(t)
+		return
+	}
+	// An independent raw socket observes the actual IP TTL, not a mock setter.
+	sniffer, err := net.ListenIP("ip4:icmp", &net.IPAddr{IP: net.ParseIP("127.0.0.1")})
+	if err != nil {
+		t.Skipf("raw socket unavailable: %v", err)
+	}
+	defer sniffer.Close()
+	c := make(traceTestContext, 16)
+	addr := netip.MustParseAddr("127.0.0.1")
+	d, err := ConnectTraceDestination(context.Background(), logger.NOP(), nil, addr, addr, c, 2*time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer d.Close()
+	for _, hop := range []byte{1, 2, 7, 31} {
+		if err := d.WritePacket(buf.As(testTracePacket(addr.String(), addr.String(), hop, testTraceEcho(false, 333, uint16(hop), false))).ToOwned()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	sniffer.SetReadDeadline(time.Now().Add(2 * time.Second))
+	seen := make(map[byte]bool)
+	for len(seen) < 4 {
+		b := make([]byte, 2048)
+		n, _, _, _, err := sniffer.ReadMsgIP(b, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		off, _, _, err := traceIP(b[:n], false)
+		if err != nil || b[off] != 8 {
+			continue
+		}
+		seq := binary.BigEndian.Uint16(b[off+6 : off+8])
+		if seq != 1 && seq != 2 && seq != 7 && seq != 31 {
+			continue
+		}
+		if b[8] != byte(seq) {
+			t.Fatalf("TTL changed on wire: seq %d TTL %d", seq, b[8])
+		}
+		seen[b[8]] = true
+	}
+}
+
+func testTraceHopBudgetSocket(t *testing.T) {
+	for _, target := range []string{"127.0.0.1", "::1"} {
+		t.Run(target, func(t *testing.T) {
+			addr := netip.MustParseAddr(target)
+			c := make(traceTestContext, 16)
+			destination, err := ConnectTraceDestination(context.Background(), logger.NOP(), nil, addr, addr, c, 5*time.Second)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer destination.Close()
+			d := destination.(*TraceDestination)
+			for _, hop := range []byte{1, 2, 7, 31} {
+				request := testTracePacket(target, target, hop, testTraceEcho(addr.Is6(), 333, uint16(hop), false))
+				if err := d.WritePacket(buf.As(request).ToOwned()); err != nil {
+					t.Fatal(err)
+				}
+				// These getters call getsockopt on the same real socket used by
+				// WritePacket, rather than inspecting a mock or a stored value.
+				var actual int
+				if addr.Is4() {
+					actual, err = ipv4.NewPacketConn(d.conn).TTL()
+				} else {
+					actual, err = ipv6.NewPacketConn(d.conn).HopLimit()
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				if actual != int(hop) {
+					t.Fatalf("socket hop budget: sent %d, read back %d", hop, actual)
+				}
+				select {
+				case reply := <-c:
+					off, source, targetAddr, err := traceIP(reply, false)
+					if err != nil {
+						t.Fatal(err)
+					}
+					replyType := byte(0)
+					if addr.Is6() {
+						replyType = 129
+					}
+					if source != addr || targetAddr != addr || reply[off] != replyType ||
+						binary.BigEndian.Uint16(reply[off+4:off+6]) != 333 ||
+						binary.BigEndian.Uint16(reply[off+6:off+8]) != uint16(hop) {
+						t.Fatal("loopback reply does not match the probe")
+					}
+				case <-time.After(3 * time.Second):
+					t.Fatal("no real loopback reply")
+				}
+				t.Logf("real socket hop budget %d and Echo round trip verified", actual)
+			}
+		})
+	}
+}

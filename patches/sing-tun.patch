diff --git a/ping/trace.go b/ping/trace.go
new file mode 100644
index 0000000..b988e82
--- /dev/null
+++ b/ping/trace.go
@@ -0,0 +1,485 @@
+package ping
+
+// Experimental transparent Echo/ICMP-error forwarding. Unlike the legacy ping
+// connection, this uses an unconnected raw socket so errors from intermediate
+// routers can arrive, preserves each probe's hop budget, and matches errors by
+// their quoted request rather than treating the error header as an Echo header.
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	tun "github.com/metacubex/sing-tun"
+	"github.com/metacubex/sing/common/buf"
+	"github.com/metacubex/sing/common/control"
+	"github.com/metacubex/sing/common/logger"
+	"golang.org/x/net/ipv4"
+	"golang.org/x/net/ipv6"
+)
+
+// IDs are reserved across all destinations: unconnected raw sockets may receive
+// the same packet. Never deliver another session's reply on an ID collision.
+var traceIDs = struct {
+	sync.Mutex
+	used  [65536]bool
+	next  uint16
+	count int
+}{}
+
+func reserveTraceID() (uint16, error) {
+	traceIDs.Lock()
+	defer traceIDs.Unlock()
+	if traceIDs.count >= 4096 {
+		return 0, errors.New("ICMP trace pending-probe limit reached")
+	}
+	for {
+		traceIDs.next++
+		if !traceIDs.used[traceIDs.next] {
+			traceIDs.used[traceIDs.next] = true
+			traceIDs.count++
+			return traceIDs.next, nil
+		}
+	}
+}
+
+func releaseTraceID(id uint16) {
+	traceIDs.Lock()
+	if traceIDs.used[id] {
+		traceIDs.used[id] = false
+		traceIDs.count--
+	}
+	traceIDs.Unlock()
+}
+
+type traceProbe struct {
+	// Original IP header and first eight ICMP bytes, enough to restore an error
+	// quote without retaining arbitrarily large application payloads.
+	header   []byte
+	source   netip.Addr
+	target   netip.Addr
+	sequence uint16
+	expires  time.Time
+}
+
+type TraceDestination struct {
+	conn          *net.IPConn
+	target        netip.Addr
+	visibleTarget netip.Addr
+	context       tun.DirectRouteContext
+	logger        logger.ContextLogger
+	ctx           context.Context
+	timeout       time.Duration
+	closed        atomic.Bool
+	writeMu       sync.Mutex
+	ipv4Options   bool
+	mu            sync.Mutex
+	probes        map[uint16]traceProbe
+}
+
+func ConnectTraceDestination(ctx context.Context, log logger.ContextLogger, socketControl control.Func,
+	target, visibleTarget netip.Addr, routeContext tun.DirectRouteContext, timeout time.Duration,
+) (tun.DirectRouteDestination, error) {
+	if !target.IsValid() || target.Is4() != visibleTarget.Is4() || routeContext == nil {
+		return nil, errors.New("invalid ICMP trace destination")
+	}
+	network, bind := "ip4:icmp", "0.0.0.0"
+	if target.Is6() {
+		network, bind = "ip6:ipv6-icmp", "::"
+	}
+	lc := net.ListenConfig{Control: socketControl}
+	packetConn, err := lc.ListenPacket(ctx, network, bind)
+	if err != nil {
+		return nil, err
+	}
+	conn, ok := packetConn.(*net.IPConn)
+	if !ok {
+		packetConn.Close()
+		return nil, errors.New("ICMP trace requires an IP socket")
+	}
+	if target.Is6() {
+		if err = enableTraceIPv6Control(conn); err != nil {
+			conn.Close()
+			return nil, err
+		}
+	}
+	if timeout <= 0 {
+		timeout = 30 * time.Second
+	}
+	d := &TraceDestination{conn: conn, target: target, visibleTarget: visibleTarget, context: routeContext,
+		logger: log, ctx: ctx, timeout: timeout, probes: make(map[uint16]traceProbe)}
+	go d.readLoop()
+	return d, nil
+}
+
+// traceIP accepts a truncated ICMP quote but never a truncated IP header. IPv6
+// extension headers and IP fragments are deliberately rejected in this prototype.
+func traceIP(packet []byte, quoted bool) (offset int, source, target netip.Addr, err error) {
+	bad := errors.New("unsupported or truncated ICMP trace IP packet")
+	if len(packet) < 20 {
+		return 0, source, target, bad
+	}
+	switch packet[0] >> 4 {
+	case 4:
+		offset = int(packet[0]&15) * 4
+		length := int(binary.BigEndian.Uint16(packet[2:4]))
+		if offset < 20 || len(packet) < offset+8 || length < offset+8 || (!quoted && length != len(packet)) || packet[9] != 1 || binary.BigEndian.Uint16(packet[6:8])&0x3fff != 0 {
+			return 0, source, target, bad
+		}
+		source = netip.AddrFrom4([4]byte(packet[12:16]))
+		target = netip.AddrFrom4([4]byte(packet[16:20]))
+	case 6:
+		offset = 40
+		if len(packet) < 48 || packet[6] != 58 || (!quoted && int(binary.BigEndian.Uint16(packet[4:6]))+40 != len(packet)) || binary.BigEndian.Uint16(packet[4:6]) < 8 {
+			return 0, source, target, bad
+		}
+		source = netip.AddrFrom16([16]byte(packet[8:24]))
+		target = netip.AddrFrom16([16]byte(packet[24:40]))
+	default:
+		return 0, source, target, bad
+	}
+	return
+}
+
+func traceChecksum(data []byte) uint16 {
+	var sum uint32
+	for len(data) >= 2 {
+		sum += uint32(binary.BigEndian.Uint16(data))
+		data = data[2:]
+	}
+	if len(data) == 1 {
+		sum += uint32(data[0]) << 8
+	}
+	for sum>>16 != 0 {
+		sum = (sum & 0xffff) + (sum >> 16)
+	}
+	return ^uint16(sum)
+}
+
+func traceChecksums(packet []byte, offset int) {
+	icmp := packet[offset:]
+	icmp[2], icmp[3] = 0, 0
+	if packet[0]>>4 == 4 {
+		packet[10], packet[11] = 0, 0
+		binary.BigEndian.PutUint16(packet[10:12], traceChecksum(packet[:offset]))
+		binary.BigEndian.PutUint16(icmp[2:4], traceChecksum(icmp))
+	} else {
+		pseudo := make([]byte, 40+len(icmp))
+		copy(pseudo, packet[8:40])
+		binary.BigEndian.PutUint32(pseudo[32:36], uint32(len(icmp)))
+		pseudo[39] = 58
+		copy(pseudo[40:], icmp)
+		binary.BigEndian.PutUint16(icmp[2:4], traceChecksum(pseudo))
+	}
+}
+
+func (d *TraceDestination) expireLocked(now time.Time) {
+	for id, probe := range d.probes {
+		if !now.Before(probe.expires) {
+			delete(d.probes, id)
+			releaseTraceID(id)
+		}
+	}
+}
+
+// Accept Record Route plus its NOP/EOL padding. Source-routing and other
+// options would change the forwarding contract and remain unsupported.
+func traceIPv4Options(options []byte) error {
+	if len(options) > 40 || len(options)%4 != 0 {
+		return errors.New("invalid ICMP trace IPv4 option length")
+	}
+	recordRoute := false
+	for i := 0; i < len(options); {
+		switch options[i] {
+		case 0: // End of option list; remaining bytes are padding.
+			for _, padding := range options[i:] {
+				if padding != 0 {
+					return errors.New("invalid ICMP trace IPv4 option padding")
+				}
+			}
+			return nil
+		case 1: // No operation.
+			i++
+		case 7: // Record Route, RFC 791.
+			if recordRoute || i+3 > len(options) {
+				return errors.New("invalid ICMP trace IPv4 Record Route option")
+			}
+			length, pointer := int(options[i+1]), int(options[i+2])
+			if length < 3 || length > len(options)-i || (length-3)%4 != 0 ||
+				pointer < 4 || pointer > length+1 || (pointer-4)%4 != 0 {
+				return errors.New("invalid ICMP trace IPv4 Record Route length or pointer")
+			}
+			recordRoute = true
+			i += length
+		default:
+			return fmt.Errorf("unsupported ICMP trace IPv4 option type %d", options[i])
+		}
+	}
+	return nil
+}
+
+func (d *TraceDestination) WritePacket(packet *buf.Buffer) error {
+	defer packet.Release()
+	p := packet.Bytes()
+	off, source, target, err := traceIP(p, false)
+	if err != nil {
+		return err
+	}
+	echoType, hop := byte(8), int(p[8])
+	if target.Is6() {
+		echoType, hop = 128, int(p[7])
+	}
+	if target != d.visibleTarget {
+		return fmt.Errorf("ICMP trace target %s does not match session %s", target, d.visibleTarget)
+	}
+	if p[off] != echoType || p[off+1] != 0 {
+		return fmt.Errorf("ICMP trace requires Echo request type/code %d/0, got %d/%d", echoType, p[off], p[off+1])
+	}
+	if hop == 0 {
+		return errors.New("ICMP trace requires a nonzero hop budget")
+	}
+	if target.Is4() {
+		if err := traceIPv4Options(p[20:off]); err != nil {
+			return err
+		}
+	}
+	d.writeMu.Lock()
+	defer d.writeMu.Unlock()
+	if d.closed.Load() {
+		return net.ErrClosed
+	}
+	if target.Is4() && (off > 20 || d.ipv4Options) {
+		// IP_OPTIONS is socket state, just like TTL. Apply/reset it while
+		// holding the send lock so one probe cannot affect another probe.
+		if err := setTraceIPv4Options(d.conn, p[20:off]); err != nil {
+			return fmt.Errorf("set ICMP trace IPv4 options: %w", err)
+		}
+		d.ipv4Options = off > 20
+	}
+	// TTL is a socket option. Serialize setting it with sending the packet, so
+	// simultaneous probes with different TTLs cannot race each other.
+	if target.Is4() {
+		err = ipv4.NewPacketConn(d.conn).SetTTL(hop)
+	} else {
+		err = ipv6.NewPacketConn(d.conn).SetHopLimit(hop)
+	}
+	if err != nil {
+		return err
+	}
+	d.mu.Lock()
+	d.expireLocked(time.Now())
+	id, err := reserveTraceID()
+	if err != nil {
+		d.mu.Unlock()
+		return err
+	}
+	probe := traceProbe{header: append([]byte(nil), p[:off+8]...), source: source, target: target,
+		sequence: binary.BigEndian.Uint16(p[off+6 : off+8]), expires: time.Now().Add(d.timeout)}
+	d.probes[id] = probe
+	d.mu.Unlock()
+	payload := append([]byte(nil), p[off:]...)
+	binary.BigEndian.PutUint16(payload[4:6], id)
+	payload[2], payload[3] = 0, 0
+	if target.Is4() {
+		binary.BigEndian.PutUint16(payload[2:4], traceChecksum(payload))
+	}
+	// The IPv6 raw socket computes its checksum using the real egress source.
+	_, err = d.conn.WriteToIP(payload, &net.IPAddr{IP: net.IP(d.target.AsSlice()), Zone: d.target.Zone()})
+	if err != nil {
+		d.mu.Lock()
+		delete(d.probes, id)
+		releaseTraceID(id)
+		d.mu.Unlock()
+	} else {
+		d.logger.DebugContext(d.ctx, "ICMP trace send: target ", d.target, " hop ", hop,
+			" id ", binary.BigEndian.Uint16(probe.header[off+4:off+6]), " -> ", id, " seq ", probe.sequence)
+	}
+	return err
+}
+
+// restoreTraceReply validates the echoed request before changing any packet.
+// Intermediate-router source addresses and error type/code/MTU stay intact.
+func restoreTraceReply(packet []byte, realTarget netip.Addr, lookup func(uint16, uint16) (traceProbe, bool)) ([]byte, bool) {
+	off, router, _, err := traceIP(packet, false)
+	if err != nil {
+		return nil, false
+	}
+	icmp := packet[off:]
+	echo, isError := false, false
+	if realTarget.Is4() {
+		echo = icmp[0] == 0 && icmp[1] == 0
+		isError = icmp[0] == 3 || icmp[0] == 11 || icmp[0] == 12
+	} else {
+		echo = icmp[0] == 129 && icmp[1] == 0
+		isError = icmp[0] >= 1 && icmp[0] <= 4
+	}
+	var id, sequence uint16
+	var quoted []byte
+	var qoff int
+	if echo {
+		if router != realTarget {
+			return nil, false
+		}
+		id, sequence = binary.BigEndian.Uint16(icmp[4:6]), binary.BigEndian.Uint16(icmp[6:8])
+	} else if isError {
+		quoted = icmp[8:]
+		var quotedTarget netip.Addr
+		qoff, _, quotedTarget, err = traceIP(quoted, true)
+		if err != nil || quotedTarget != realTarget {
+			return nil, false
+		}
+		expectedType := byte(8)
+		if realTarget.Is6() {
+			expectedType = 128
+		}
+		if quoted[qoff] != expectedType || quoted[qoff+1] != 0 {
+			return nil, false
+		}
+		id, sequence = binary.BigEndian.Uint16(quoted[qoff+4:qoff+6]), binary.BigEndian.Uint16(quoted[qoff+6:qoff+8])
+	} else {
+		return nil, false
+	}
+	probe, ok := lookup(id, sequence)
+	if !ok {
+		return nil, false
+	}
+	if realTarget.Is4() {
+		copy(packet[16:20], probe.source.AsSlice())
+		if echo {
+			copy(packet[12:16], probe.target.AsSlice())
+		} else {
+			copy(quoted[12:16], probe.source.AsSlice())
+			copy(quoted[16:20], probe.target.AsSlice())
+			quoted[10], quoted[11] = 0, 0
+			binary.BigEndian.PutUint16(quoted[10:12], traceChecksum(quoted[:qoff]))
+		}
+	} else {
+		copy(packet[24:40], probe.source.AsSlice())
+		if echo {
+			copy(packet[8:24], probe.target.AsSlice())
+		} else {
+			copy(quoted[8:24], probe.source.AsSlice())
+			copy(quoted[24:40], probe.target.AsSlice())
+		}
+	}
+	originalOffset := int(probe.header[0]&15) * 4
+	if probe.target.Is6() {
+		originalOffset = 40
+	}
+	if echo {
+		copy(icmp[4:8], probe.header[originalOffset+4:originalOffset+8])
+	} else {
+		// Restore the original checksum as well as ID/sequence. Recomputing a
+		// checksum over a truncated quote would corrupt the quoted ICMP header.
+		copy(quoted[qoff+2:qoff+8], probe.header[originalOffset+2:originalOffset+8])
+	}
+	traceChecksums(packet, off)
+	return packet, true
+}
+
+func (d *TraceDestination) readLoop() {
+	defer d.Close()
+	data, oob := make([]byte, 65575), make([]byte, 1024)
+	diagnosticReceives := 0
+	for {
+		if err := d.conn.SetReadDeadline(time.Now().Add(d.timeout)); err != nil {
+			return
+		}
+		n, oobn, _, sender, err := d.conn.ReadMsgIP(data, oob)
+		if err != nil {
+			if !d.closed.Load() {
+				d.logger.DebugContext(d.ctx, "ICMP trace receive: ", err)
+			}
+			return
+		}
+		packet := append([]byte(nil), data[:n]...)
+		if d.target.Is6() {
+			if sender == nil || n < 8 {
+				continue
+			}
+			cm, err := parseIPv6ControlMessage(oob[:oobn])
+			if err != nil || cm.HopLimit <= 0 {
+				continue
+			}
+			packet = make([]byte, 40+n)
+			packet[0], packet[6], packet[7] = 0x60, 58, byte(cm.HopLimit)
+			binary.BigEndian.PutUint16(packet[4:6], uint16(n))
+			copy(packet[8:24], sender.IP.To16())
+			copy(packet[40:], data[:n])
+		} else if runtime.GOOS == "darwin" && len(packet) >= 20 {
+			// Darwin returns these two header fields in host byte order.
+			binary.BigEndian.PutUint16(packet[2:4], binary.LittleEndian.Uint16(packet[2:4])+uint16(packet[0]&15)*4)
+			binary.BigEndian.PutUint16(packet[6:8], binary.LittleEndian.Uint16(packet[6:8]))
+		}
+		// A raw socket also receives unrelated ICMP traffic. Bound these debug
+		// details and never log payloads; they distinguish receive, match, and
+		// TUN injection failures during platform compatibility testing.
+		diagnosticReceive := diagnosticReceives < 128
+		if diagnosticReceive {
+			diagnosticReceives++
+			off, router, _, parseErr := traceIP(packet, false)
+			if parseErr != nil {
+				d.logger.DebugContext(d.ctx, "ICMP trace receive: bytes ", len(packet), " invalid IP header: ", parseErr)
+			} else {
+				icmp := packet[off:]
+				id, sequence := uint16(0), uint16(0)
+				if icmp[0] == 0 || icmp[0] == 129 {
+					id, sequence = binary.BigEndian.Uint16(icmp[4:6]), binary.BigEndian.Uint16(icmp[6:8])
+				} else if qoff, _, _, qerr := traceIP(icmp[8:], true); qerr == nil {
+					id, sequence = binary.BigEndian.Uint16(icmp[8+qoff+4:8+qoff+6]), binary.BigEndian.Uint16(icmp[8+qoff+6:8+qoff+8])
+				}
+				d.logger.DebugContext(d.ctx, "ICMP trace receive: bytes ", len(packet), " router ", router,
+					" type ", icmp[0], " code ", icmp[1], " id ", id, " seq ", sequence)
+			}
+		}
+		d.mu.Lock()
+		d.expireLocked(time.Now())
+		restored, ok := restoreTraceReply(packet, d.target, func(id, sequence uint16) (traceProbe, bool) {
+			probe, exists := d.probes[id]
+			if !exists || sequence != probe.sequence {
+				return traceProbe{}, false
+			}
+			delete(d.probes, id)
+			releaseTraceID(id)
+			return probe, true
+		})
+		d.mu.Unlock()
+		if diagnosticReceive {
+			d.logger.DebugContext(d.ctx, "ICMP trace receive match: target ", d.target, " accepted ", ok)
+		}
+		if ok {
+			if err := d.context.WritePacket(restored); err != nil {
+				d.logger.DebugContext(d.ctx, "ICMP trace write back: ", err)
+			} else {
+				d.logger.DebugContext(d.ctx, "ICMP trace write back: target ", d.target, " bytes ", len(restored), " success")
+			}
+		}
+	}
+}
+
+func (d *TraceDestination) Close() error {
+	if d.closed.Swap(true) {
+		return nil
+	}
+	d.writeMu.Lock()
+	defer d.writeMu.Unlock()
+	err := d.conn.Close()
+	d.mu.Lock()
+	for id := range d.probes {
+		releaseTraceID(id)
+		delete(d.probes, id)
+	}
+	d.mu.Unlock()
+	return err
+}
+
+func (d *TraceDestination) IsClosed() bool { return d.closed.Load() }
+
+var _ tun.DirectRouteDestination = (*TraceDestination)(nil)
diff --git a/ping/trace_control_unix.go b/ping/trace_control_unix.go
new file mode 100644
index 0000000..1482a29
--- /dev/null
+++ b/ping/trace_control_unix.go
@@ -0,0 +1,28 @@
+//go:build unix
+
+package ping
+
+import (
+	"golang.org/x/net/ipv6"
+	"golang.org/x/sys/unix"
+	"net"
+)
+
+func enableTraceIPv6Control(conn *net.IPConn) error {
+	return ipv6.NewPacketConn(conn).SetControlMessage(ipv6.FlagHopLimit, true)
+}
+
+func setTraceIPv4Options(conn *net.IPConn, options []byte) error {
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		return err
+	}
+	var socketErr error
+	err = raw.Control(func(fd uintptr) {
+		socketErr = unix.SetsockoptString(int(fd), unix.IPPROTO_IP, unix.IP_OPTIONS, string(options))
+	})
+	if err != nil {
+		return err
+	}
+	return socketErr
+}
diff --git a/ping/trace_control_windows.go b/ping/trace_control_windows.go
new file mode 100644
index 0000000..69ce353
--- /dev/null
+++ b/ping/trace_control_windows.go
@@ -0,0 +1,43 @@
+package ping
+
+import (
+	"golang.org/x/sys/windows"
+	"net"
+)
+
+func enableTraceIPv6Control(conn *net.IPConn) error {
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		return err
+	}
+	var socketErr error
+	err = raw.Control(func(fd uintptr) {
+		socketErr = windows.SetsockoptInt(windows.Handle(fd), windows.IPPROTO_IPV6, IPV6_HOPLIMIT, 1)
+	})
+	if err != nil {
+		return err
+	}
+	return socketErr
+}
+
+func setTraceIPv4Options(conn *net.IPConn, options []byte) error {
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		return err
+	}
+	var socketErr error
+	var optionPtr *byte
+	if len(options) != 0 {
+		optionPtr = &options[0]
+	}
+	err = raw.Control(func(fd uintptr) {
+		// Winsock IP_OPTIONS (1) inserts these options into outgoing IPv4
+		// packets. A nil pointer and zero length clears previous options.
+		socketErr = windows.Setsockopt(windows.Handle(fd), windows.IPPROTO_IP, 1,
+			optionPtr, int32(len(options)))
+	})
+	if err != nil {
+		return err
+	}
+	return socketErr
+}
diff --git a/ping/trace_options_unix_test.go b/ping/trace_options_unix_test.go
new file mode 100644
index 0000000..cafb252
--- /dev/null
+++ b/ping/trace_options_unix_test.go
@@ -0,0 +1,25 @@
+//go:build unix
+
+package ping
+
+import (
+	"net"
+
+	"golang.org/x/sys/unix"
+)
+
+func testTraceReadIPv4Options(conn *net.IPConn) ([]byte, error) {
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		return nil, err
+	}
+	var options string
+	var socketErr error
+	err = raw.Control(func(fd uintptr) {
+		options, socketErr = unix.GetsockoptString(int(fd), unix.IPPROTO_IP, unix.IP_OPTIONS)
+	})
+	if err != nil {
+		return nil, err
+	}
+	return []byte(options), socketErr
+}
diff --git a/ping/trace_options_windows_test.go b/ping/trace_options_windows_test.go

+func TestTraceRealRouter(t *testing.T) {
+	if os.Getenv("ICMP_TRACE_NETWORK_TEST") != "1" {
+		t.Skip("opt-in external TTL=1 probe")
+	}
+	addr := netip.MustParseAddr("1.1.1.1")
+	c := make(traceTestContext, 2)
+	d, err := ConnectTraceDestination(context.Background(), logger.NOP(), nil, addr, addr, c, 5*time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer d.Close()
+	if err = d.WritePacket(buf.As(testTracePacket("198.18.0.1", addr.String(), 1, testTraceEcho(false, 123, 456, false))).ToOwned()); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case p := <-c:
+		off, router, _, err := traceIP(p, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if p[off] != 11 || router == addr {
+			t.Fatalf("expected intermediate TTL-exceeded, got type %d source %s", p[off], router)
+		}
+		t.Logf("real TTL=1 response from %s, original probe restored", router)
+	case <-time.After(6 * time.Second):
+		t.Fatal("no router response (network may filter ICMP)")
+	}
+}

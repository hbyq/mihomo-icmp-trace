@@ -0,0 +1,29 @@
+package ping
+
+import (
+	"net"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+func testTraceReadIPv4Options(conn *net.IPConn) ([]byte, error) {
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		return nil, err
+	}
+	options := make([]byte, 40)
+	length := int32(len(options))
+	var socketErr error
+	err = raw.Control(func(fd uintptr) {
+		socketErr = windows.Getsockopt(windows.Handle(fd), windows.IPPROTO_IP, 1,
+			(*byte)(unsafe.Pointer(unsafe.SliceData(options))), &length)
+	})
+	if err != nil {
+		return nil, err
+	}
+	if socketErr != nil {
+		return nil, socketErr
+	}
+	return options[:length], nil
+}

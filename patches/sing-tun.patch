+func testTracePacket(src, dst string, hop byte, body []byte) []byte {
+	s, d := netip.MustParseAddr(src), netip.MustParseAddr(dst)
+	off := 20
+	if s.Is6() {
+		off = 40
+	}
+	p := make([]byte, off+len(body))
+	if off == 20 {
+		p[0], p[8], p[9] = 0x45, hop, 1
+		binary.BigEndian.PutUint16(p[2:4], uint16(len(p)))
+		copy(p[12:16], s.AsSlice())
+		copy(p[16:20], d.AsSlice())
+	} else {
+		p[0], p[6], p[7] = 0x60, 58, hop
+		binary.BigEndian.PutUint16(p[4:6], uint16(len(body)))
+		copy(p[8:24], s.AsSlice())
+		copy(p[24:40], d.AsSlice())
+	}
+	copy(p[off:], body)
+	traceChecksums(p, off)
+	return p
+}
+
+func testTraceEcho(v6 bool, id, seq uint16, reply bool) []byte {
+	b := make([]byte, 16)
+	b[0] = 8
+	if v6 {
+		b[0] = 128
+	}
+	if reply {
+		if v6 {
+			b[0] = 129
+		} else {
+			b[0] = 0
+		}
+	}
+	binary.BigEndian.PutUint16(b[4:6], id)
+	binary.BigEndian.PutUint16(b[6:8], seq)
+	copy(b[8:], "trace123")
+	return b
+}

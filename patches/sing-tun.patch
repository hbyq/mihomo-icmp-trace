+func FuzzTraceReply(f *testing.F) {
+	f.Add(testTracePacket("203.0.113.20", "192.0.2.10", 51, testTraceEcho(false, 789, 456, true)))
+	f.Fuzz(func(t *testing.T, p []byte) {
+		restoreTraceReply(p, netip.MustParseAddr("203.0.113.20"), func(uint16, uint16) (traceProbe, bool) { return traceProbe{}, false })
+	})

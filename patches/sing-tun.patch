+func TestTraceRecordRouteLoopback(t *testing.T) {
+	addr := netip.MustParseAddr("127.0.0.1")
+	c := make(traceTestContext, 16)
+	destination, err := ConnectTraceDestination(context.Background(), logger.NOP(), nil, addr, addr, c, 5*time.Second)
+	if err != nil {
+		t.Skipf("raw ICMP socket unavailable: %v", err)
+	}
+	defer destination.Close()
+	d := destination.(*TraceDestination)
+	for _, withOptions := range []bool{true, false} {
+		request := testTracePacket(addr.String(), addr.String(), 7, testTraceEcho(false, 123, 456, false))
+		if withOptions {
+			request = testTraceRecordRoute(request)
+		}
+		if err := d.WritePacket(buf.As(request).ToOwned()); err != nil {
+			t.Fatal(err)
+		}
+		options, err := testTraceReadIPv4Options(d.conn)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if withOptions {
+			if len(options) < 3 || options[0] != 7 || options[1] != 39 {
+				t.Fatalf("Record Route not set on real socket: %v", options)
+			}
+		} else if len(options) != 0 {
+			t.Fatalf("Record Route leaked into subsequent normal probe: %v", options)
+		}
+		select {
+		case reply := <-c:
+			off, _, _, err := traceIP(reply, false)
+			if err != nil || reply[off] != 0 || binary.BigEndian.Uint16(reply[off+4:off+6]) != 123 ||
+				binary.BigEndian.Uint16(reply[off+6:off+8]) != 456 {
+				t.Fatal("real RR/normal Echo reply does not match original probe")
+			}
+		case <-time.After(3 * time.Second):
+			t.Fatal("no real RR/normal loopback reply")
+		}
+	}
+}

index 0000000..6c55250
--- /dev/null
+++ b/listener/sing_tun/icmp_trace.go
@@ -0,0 +1,117 @@
+package sing_tun
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/metacubex/mihomo/log"
+	tun "github.com/metacubex/sing-tun"
+	"github.com/metacubex/sing/common/buf"
+)
+
+// DNS resolution and raw-socket setup must not block the TUN read loop. Return
+// a real destination immediately, even on failure: a nil destination makes the
+// upstream stacks fall back to synthetic Echo replies.
+type asyncICMPTrace struct {
+	mu       sync.Mutex
+	closed   atomic.Bool
+	queue    chan *buf.Buffer
+	done     chan struct{}
+	cancel   context.CancelFunc
+	delegate tun.DirectRouteDestination
+}
+
+func newAsyncICMPTrace(create func(context.Context) (tun.DirectRouteDestination, error), timeout time.Duration) *asyncICMPTrace {
+	ctx, cancel := context.WithCancel(context.Background())
+	d := &asyncICMPTrace{queue: make(chan *buf.Buffer, 32), done: make(chan struct{}), cancel: cancel}
+	if timeout <= 0 {
+		timeout = 30 * time.Second
+	}
+	go func() {
+		defer func() {
+			d.Close()
+			for {
+				select {
+				case packet := <-d.queue:
+					packet.Release()
+				default:
+					return
+				}
+			}
+		}()
+		delegate, err := create(ctx)
+		if err != nil {
+			log.Warnln("[ICMP TRACE] setup failed (no synthetic reply): %v", err)
+			return
+		}
+		defer delegate.Close()
+		d.mu.Lock()
+		d.delegate = delegate
+		d.mu.Unlock()
+		timer := time.NewTimer(timeout)
+		defer timer.Stop()
+		for {
+			select {
+			case <-d.done:
+				return
+			case <-timer.C:
+				return
+			case packet := <-d.queue:
+				if d.closed.Load() {
+					packet.Release()
+					return
+				}
+				if err := delegate.WritePacket(packet); err != nil {
+					log.Warnln("[ICMP TRACE] send failed (no synthetic reply): %v", err)
+				}
+				if delegate.IsClosed() {
+					return
+				}
+				if !timer.Stop() {
+					select {
+					case <-timer.C:
+					default:
+					}
+				}
+				timer.Reset(timeout)
+			}
+		}
+	}()
+	return d
+}
+
+func (d *asyncICMPTrace) WritePacket(packet *buf.Buffer) error {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.closed.Load() {
+		packet.Release()
+		return net.ErrClosed
+	}
+	select {
+	case d.queue <- packet:
+		return nil
+	default:
+		packet.Release()
+		return errors.New("ICMP trace startup/send queue is full")
+	}
+}
+
+func (d *asyncICMPTrace) Close() error {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if !d.closed.Swap(true) {
+		d.cancel()
+		close(d.done)
+	}
+	return nil
+}
+
+func (d *asyncICMPTrace) IsClosed() bool {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	return d.closed.Load() || (d.delegate != nil && d.delegate.IsClosed())
+}
diff --git a/listener/sing_tun/icmp_trace_test.go b/listener/sing_tun/icmp_trace_test.go
new file mode 100644
index 0000000..cb8b36b
--- /dev/null
+++ b/listener/sing_tun/icmp_trace_test.go
@@ -0,0 +1,105 @@
+package sing_tun
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	tun "github.com/metacubex/sing-tun"
+	"github.com/metacubex/sing/common/buf"
+)
+
+type testTraceDelegate struct {
+	packets chan string
+	closed  atomic.Bool
+}
+
+func (d *testTraceDelegate) WritePacket(b *buf.Buffer) error {
+	defer b.Release()
+	d.packets <- string(b.Bytes())
+	return nil
+}
+func (d *testTraceDelegate) Close() error   { d.closed.Store(true); return nil }
+func (d *testTraceDelegate) IsClosed() bool { return d.closed.Load() }
+
+func TestAsyncICMPTraceDoesNotBlockTUNOnDNS(t *testing.T) {
+	ready := make(chan struct{})
+	delegate := &testTraceDelegate{packets: make(chan string, 2)}
+	d := newAsyncICMPTrace(func(ctx context.Context) (tun.DirectRouteDestination, error) {
+		select {
+		case <-ready:
+			return delegate, nil
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}, time.Second)
+	defer d.Close()
+	completed := make(chan error, 1)
+	go func() { completed <- d.WritePacket(buf.As([]byte("first probe")).ToOwned()) }()
+	select {
+	case err := <-completed:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("TUN caller blocked on DNS")
+	}
+	close(ready)
+	select {
+	case packet := <-delegate.packets:
+		if packet != "first probe" {
+			t.Fatal("probe changed")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("queued probe lost")
+	}
+	delegate.Close()
+	if !d.IsClosed() {
+		t.Fatal("closed raw socket would be reused")
+	}
+}
+
+func TestAsyncICMPTraceSetupFailureNeverReturnsNilDestination(t *testing.T) {
+	d := newAsyncICMPTrace(func(context.Context) (tun.DirectRouteDestination, error) {
+		return nil, errors.New("DNS/raw socket failure")
+	}, time.Second)
+	if d == nil {
+		t.Fatal("nil permits synthetic ping fallback")
+	}
+	defer d.Close()
+	deadline := time.Now().Add(time.Second)
+	for !d.IsClosed() && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if !d.IsClosed() {
+		t.Fatal("failed destination remained healthy")
+	}
+	if err := d.WritePacket(buf.As([]byte("late probe")).ToOwned()); err == nil {
+		t.Fatal("failed destination accepted a packet")
+	}
+}
+
+func TestAsyncICMPTraceCancelAndBoundQueue(t *testing.T) {
+	exited := make(chan struct{})
+	d := newAsyncICMPTrace(func(ctx context.Context) (tun.DirectRouteDestination, error) {
+		<-ctx.Done()
+		close(exited)
+		return nil, ctx.Err()
+	}, time.Second)
+	for i := 0; i < 32; i++ {
+		if err := d.WritePacket(buf.As([]byte("pending")).ToOwned()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := d.WritePacket(buf.As([]byte("overflow")).ToOwned()); err == nil {
+		t.Fatal("startup queue is unbounded")
+	}
+	d.Close()
+	select {
+	case <-exited:
+	case <-time.After(time.Second):
+		t.Fatal("DNS setup was not cancelled")
+	}
+}

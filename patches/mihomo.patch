 func (h *ListenerHandler) PrepareConnection(network string, source M.Socksaddr, destination M.Socksaddr, routeContext tun.DirectRouteContext, timeout time.Duration) (tun.DirectRouteDestination, error) {
 	switch network {
 	case N.NetworkICMP: // our fork only send those type to PrepareConnection now
+		if h.ICMPTrace {
+			return newAsyncICMPTrace(func(ctx context.Context) (tun.DirectRouteDestination, error) {
+				if h.DisableICMPForwarding {
+					return nil, fmt.Errorf("icmp-trace conflicts with disable-icmp-forwarding")
+				}
+				target := destination.Addr
+				if resolver.IsFakeIP(target) {
+					host, found := resolver.FindHostByIP(target)
+					if !found {
+						return nil, fmt.Errorf("ICMP trace: no domain mapping for %s", target)
+					}
+					ctx, cancel := context.WithTimeout(ctx, resolver.DefaultDNSTimeout)
+					defer cancel()
+					r := resolver.DirectHostResolver
+					if r == nil {
+						r = resolver.DefaultResolver
+					}
+					var ips []netip.Addr
+					var err error
+					if target.Is4() {
+						ips, err = resolver.LookupIPv4WithResolver(ctx, host, r)
+					} else {
+						ips, err = resolver.LookupIPv6WithResolver(ctx, host, r)
+					}
+					if err != nil {
+						return nil, fmt.Errorf("ICMP trace resolve %s: %w", host, err)
+					}
+					target = netip.Addr{}
+					for _, ip := range ips {
+						if !resolver.IsFakeIP(ip) && !h.skipPingForwardingByAddr(ip) {
+							target = ip
+							break
+						}
+					}
+					if !target.IsValid() {
+						return nil, fmt.Errorf("ICMP trace: no real address for %s", host)
+					}
+				} else if h.skipPingForwardingByAddr(target) {
+					return nil, fmt.Errorf("ICMP trace: refusing TUN-local target %s", target)
+				}
+				log.Infoln("[ICMP TRACE] %s --> %s (real target %s) using DIRECT", source, destination, target)
+				return ping.ConnectTraceDestination(ctx, log.SingLogger, dialer.ICMPControl(target), target, destination.Addr, routeContext, timeout)
+			}, timeout), nil
+		}
 		if h.DisableICMPForwarding || h.skipPingForwardingByAddr(destination.Addr) { // skip if ICMP handling is disabled or other condition
 			log.Infoln("[ICMP] %s %s --> %s using fake ping echo", network, source, destination)
 			return nil, nil
